{
  "realm": "archive",
  "enabled": true,
  "accessTokenLifespan": 900,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "archive-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "document-archive-service", "access.token.claim": "true" }
        }
      ]
    },
    { "name": "documents:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "documents:write", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "documents:delete", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "metrics:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } }
  ],
  "clients": [
    {
      "clientId": "billing-service",
      "description": "Calling service of the acme tenant",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ARCHIVE_KEYCLOAK_ACME_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "webOrigins": ["http://localhost:8080"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "archive-audience"],
      "optionalClientScopes": ["documents:read", "documents:write", "documents:delete"],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "tenant_id", "claim.value": "acme", "jsonType.label": "String", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "globex-billing-service",
      "description": "Calling service of the globex tenant, to check that tenants never see each other's documents",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ARCHIVE_KEYCLOAK_GLOBEX_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "webOrigins": ["http://localhost:8080"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "archive-audience"],
      "optionalClientScopes": ["documents:read", "documents:write", "documents:delete"],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "tenant_id", "claim.value": "globex", "jsonType.label": "String", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "prometheus",
      "description": "Local metrics scraper: reads /actuator/prometheus, and nothing else",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ARCHIVE_KEYCLOAK_PROMETHEUS_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "archive-audience", "metrics:read"],
      "optionalClientScopes": []
    }
  ]
}
