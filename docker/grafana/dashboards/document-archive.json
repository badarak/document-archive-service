{
  "title": "Document Archive Service",
  "uid": "document-archive-service",
  "tags": [
    "document-archive"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "API operations",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Operations per second",
      "description": "Each API operation by outcome, refused requests included (401, 403).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(archive_upload_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "upload \u2013 {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (outcome) (rate(archive_download_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "download \u2013 {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (outcome) (rate(archive_delete_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "delete \u2013 {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "sum by (outcome) (rate(archive_read_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "read \u2013 {{outcome}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum by (outcome) (rate(archive_search_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "search \u2013 {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors by code",
      "description": "Why operations fail: the code of their error answer.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (error_code) (rate(archive_upload_seconds_count{application=\"document-archive-service\",outcome!=\"success\"}[1m]))",
          "legendFormat": "upload \u2013 {{error_code}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (error_code) (rate(archive_download_seconds_count{application=\"document-archive-service\",outcome!=\"success\"}[1m]))",
          "legendFormat": "download \u2013 {{error_code}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (error_code) (rate(archive_delete_seconds_count{application=\"document-archive-service\",outcome!=\"success\"}[1m]))",
          "legendFormat": "delete \u2013 {{error_code}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "sum by (error_code) (rate(archive_read_seconds_count{application=\"document-archive-service\",outcome!=\"success\"}[1m]))",
          "legendFormat": "read \u2013 {{error_code}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum by (error_code) (rate(archive_search_seconds_count{application=\"document-archive-service\",outcome!=\"success\"}[1m]))",
          "legendFormat": "search \u2013 {{error_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average duration",
      "description": "Average duration of each operation, downloads streamed to their end.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(archive_upload_seconds_sum{application=\"document-archive-service\"}[1m])) / sum(rate(archive_upload_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "upload"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(archive_download_seconds_sum{application=\"document-archive-service\"}[1m])) / sum(rate(archive_download_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "download"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(rate(archive_delete_seconds_sum{application=\"document-archive-service\"}[1m])) / sum(rate(archive_delete_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "delete"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "sum(rate(archive_read_seconds_sum{application=\"document-archive-service\"}[1m])) / sum(rate(archive_read_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "read"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "sum(rate(archive_search_seconds_sum{application=\"document-archive-service\"}[1m])) / sum(rate(archive_search_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "search"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Download error rate",
      "description": "Share of the downloads that failed over the last 5 minutes.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(archive_download_seconds_count{application=\"document-archive-service\",outcome!=\"success\"}[5m])) or vector(0)) / sum(rate(archive_download_seconds_count{application=\"document-archive-service\"}[5m]))",
          "legendFormat": "downloads"
        }
      ]
    },
    {
      "type": "row",
      "title": "Object storage",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Storage call duration",
      "description": "Average duration of each storage call; a read is timed until its first bytes. Is R2 getting slow?",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (operation) (rate(archive_storage_seconds_sum{application=\"document-archive-service\"}[1m])) / sum by (operation) (rate(archive_storage_seconds_count{application=\"document-archive-service\"}[1m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage failures",
      "description": "Storage calls that failed, or found no object.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (operation, outcome) (rate(archive_storage_seconds_count{application=\"document-archive-service\",outcome!=\"success\"}[1m]))",
          "legendFormat": "{{operation}} \u2013 {{outcome}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Reconciliation",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Stalled documents",
      "description": "Documents still stalled after the last reconciliation run: pending archivings, deleting deletions.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "archive_reconciliation_backlog{application=\"document-archive-service\"}",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest stalled document",
      "description": "Time since the oldest stalled document was last updated; far above the grace period (15 min) means the reconciliation is blocked.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "archive_reconciliation_backlog_oldest_age_seconds{application=\"document-archive-service\"}",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reconciliation runs",
      "description": "Runs by outcome: completed, interrupted after failures in a row, or failed to read the stalled documents.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status, outcome) (increase(archive_reconciliation_runs_total{application=\"document-archive-service\"}[15m]))",
          "legendFormat": "{{status}} \u2013 {{outcome}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "API operations",
      "description": "One line per operation; open a line to see its fields and jump to its trace.",
      "id": 14,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"document-archive-service\"} |= \"answered\""
        }
      ]
    },
    {
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Abandoned archivings, failed reconciliations, errors with their stack trace.",
      "id": 15,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"document-archive-service\"} | detected_level=~\"warn|error\""
        }
      ]
    }
  ],
