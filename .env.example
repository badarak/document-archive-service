# Copy this file to .env and set the values. .env is ignored by git.
# Read by Docker Compose (compose.yaml) and by the application's "local" profile.

# PostgreSQL container
ARCHIVE_DB_NAME=archive
ARCHIVE_DB_PORT=5432

# Database credentials, shared by the container and the application
ARCHIVE_DB_USERNAME=
ARCHIVE_DB_PASSWORD=

# JDBC URL used by the application; keep it consistent with ARCHIVE_DB_NAME and ARCHIVE_DB_PORT
ARCHIVE_DB_URL=jdbc:postgresql://localhost:5432/archive

# MinIO container (S3 API and web console)
ARCHIVE_S3_PORT=9000
ARCHIVE_S3_CONSOLE_PORT=9001

# Object storage settings used by the application; locally, the credentials are also the MinIO
# root account (the secret key must be at least 8 characters long)
ARCHIVE_S3_ENDPOINT=http://localhost:9000
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=archive-documents
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
# Optional: longest time a storage call may take, retries included (2m by default)
# ARCHIVE_S3_API_CALL_TIMEOUT=2m
# Optional: console log format, ecs (JSON lines) by default outside the local profile; empty for readable logs
# ARCHIVE_LOG_FORMAT=ecs
# Optional: name the tenant of the caller in the log line of each API operation (false by default)
# ARCHIVE_LOG_TENANT=false
# Optional: longest wait for the requests in progress on shutdown; keep it above the storage call timeout (150s by default)
# ARCHIVE_SHUTDOWN_TIMEOUT=150s

# Keycloak container: the local authorization server, with its admin console on
# http://localhost:8180, two calling services and the Prometheus scraper, whose secrets are set here (any value works)
ARCHIVE_KEYCLOAK_PORT=8180
ARCHIVE_KEYCLOAK_ADMIN_USERNAME=
ARCHIVE_KEYCLOAK_ADMIN_PASSWORD=
ARCHIVE_KEYCLOAK_ACME_CLIENT_SECRET=
ARCHIVE_KEYCLOAK_GLOBEX_CLIENT_SECRET=
ARCHIVE_KEYCLOAK_PROMETHEUS_CLIENT_SECRET=

# Access token validation: the expected issuer, where it publishes the public keys that verify
# its signatures, and the audience tokens must carry. These values match the local Keycloak; keep
# the issuer and key set URIs consistent with ARCHIVE_KEYCLOAK_PORT.
ARCHIVE_JWT_ISSUER=http://localhost:8180/realms/archive
ARCHIVE_JWT_JWKS_URI=http://localhost:8180/realms/archive/protocol/openid-connect/certs
ARCHIVE_JWT_AUDIENCE=document-archive-service
# Optional: claims naming the caller's tenant and the calling service (tenant_id and azp by default)
# ARCHIVE_JWT_TENANT_CLAIM=tenant_id
# ARCHIVE_JWT_SOURCE_CLAIM=azp
# Optional: signature algorithms accepted from the issuer, comma separated (RS256 by default)
# ARCHIVE_JWT_ALGORITHMS=RS256

# Optional: publish the OpenAPI description and the Swagger UI, without authentication
# (true with the local profile, false otherwise)
# ARCHIVE_OPENAPI_ENABLED=true

# Optional: reconciliation of the deletions left DELETING and of the archivings left PENDING (on, every
# 5m, for those older than 15m, 100 at most per run, by default). The grace period must exceed
# ARCHIVE_S3_API_CALL_TIMEOUT.
# ARCHIVE_RECONCILIATION_ENABLED=true
# ARCHIVE_RECONCILIATION_INTERVAL=5m
# ARCHIVE_RECONCILIATION_GRACE_PERIOD=15m
# ARCHIVE_RECONCILIATION_BATCH_SIZE=100

# Optional: formats callers may archive, among pdf, doc, docx, mp3, wav, m4a and eml (all by default)
# ARCHIVE_ALLOWED_EXTENSIONS=pdf,doc,docx,mp3,wav,m4a,eml
