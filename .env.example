# Copy this file to .env and set the values. .env is ignored by git.
# Read by Docker Compose (compose.yaml) and by the application's "local" profile.

# PostgreSQL container
ARCHIVE_DB_NAME=archive
ARCHIVE_DB_PORT=5432

# Database credentials, shared by the container and the application
ARCHIVE_DB_USERNAME=
ARCHIVE_DB_PASSWORD=

# JDBC URL used by the application; keep it consistent with ARCHIVE_DB_NAME and ARCHIVE_DB_PORT
ARCHIVE_DB_URL=jdbc:postgresql://localhost:5432/archive

# MinIO container (S3 API and web console)
ARCHIVE_S3_PORT=9000
ARCHIVE_S3_CONSOLE_PORT=9001

# Object storage settings used by the application; locally, the credentials are also the MinIO
# root account (the secret key must be at least 8 characters long)
ARCHIVE_S3_ENDPOINT=http://localhost:9000
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=archive-documents
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=

# Access token validation: the expected issuer, where it publishes the public keys that verify
# its signatures, and the audience tokens must carry. No authorization server runs locally yet, so
# these are placeholders.
ARCHIVE_JWT_ISSUER=http://localhost:8180/realms/archive
ARCHIVE_JWT_JWKS_URI=http://localhost:8180/realms/archive/protocol/openid-connect/certs
ARCHIVE_JWT_AUDIENCE=document-archive-service

# Optional: formats callers may archive, among pdf, doc, docx, mp3, wav, m4a and eml (all by default)
# ARCHIVE_ALLOWED_EXTENSIONS=pdf,doc,docx,mp3,wav,m4a,eml
